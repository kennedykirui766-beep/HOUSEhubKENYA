# Copy this file to .env and fill in values (DO NOT commit .env)
# Example environment variables required by the app

# Flask secret key
SECRET_KEY=replace-with-a-strong-secret

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# SQLAlchemy (optional if using DATABASE_URL)
SQLALCHEMY_DATABASE_URI=

# Email (SendGrid/Mailgun/SMTP)
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_USERNAME=
MAIL_PASSWORD=
SENDER_EMAIL=noreply@example.com
SENDER_NAME=HomeHub

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin / app settings
ADMIN_EMAIL=
ADMIN_RATE_LIMIT=20
ADMIN_RATE_LIMIT_WINDOW=60

# Deployment hints
# - Do NOT commit your .env. Keep it local and/or use platform secrets.
# - Add any provider-specific keys to this example for clarity, then fill them in locally.
